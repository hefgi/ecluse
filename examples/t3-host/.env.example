# Populated automatically by ecluse — copy to .env for local dev without ecluse.
# When running under ecluse, these vars are injected directly into the process env.

# DATABASE_URL is not set in host mode; ecluse expects Postgres to be running on
# the host (e.g. via Homebrew or Postgres.app). Set the URL to match your local
# Postgres setup. In host mode each slot shares the same Postgres instance, so
# the database name should be unique per worktree. Use $ECLUSE_SLUG as a suffix.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myapp_dev"

# Assigned by ecluse: base_port + slot * stride (e.g. 3100 for slot 1)
PORT=3000

# tRPC / Next.js
NEXTAUTH_SECRET="changeme"
NEXTAUTH_URL="http://localhost:${PORT}"
